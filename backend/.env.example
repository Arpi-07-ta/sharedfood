# Copy this file to .env and replace the placeholder values with real secrets.
# Do not commit the actual .env file.

DJANGO_SECRET_KEY=replace-with-a-strong-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development

DATABASE_URL=postgresql://foodshare_user:change-me@localhost:5432/foodshare_ai
# For local SQLite development, use:
# DATABASE_URL=sqlite:////absolute/path/to/backend/db.sqlite3

JWT_SECRET_KEY=replace-with-a-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
